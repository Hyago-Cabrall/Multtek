# Configure valores reais como segredos do runtime. Nunca faça commit de chaves.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://seu-dominio.example
# DB e BUCKET são bindings, não variáveis de texto.
# Na publicação pública, configure SETUP_TOKEN como segredo no Worker.
# PUBLIC_DEPLOYMENT=true já é definido em wrangler.cloudflare.json.

# Server-only secrets. Set via wrangler secret put, never VITE_/NEXT_PUBLIC_.
DATABASE_URL=
# Direct/session pooler connection for migration runner only.
MIGRATION_DATABASE_URL=
